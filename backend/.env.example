# Copy this file to .env and fill in real values. Never commit the real .env file.

# ---------------- Core ----------------
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=false

# ---------------- Database ----------------
# "sqlite" (default, zero-config, works out of the box) or "supabase"
DB_BACKEND=sqlite
# Only used when DB_BACKEND=sqlite (optional override of default path)
SQLITE_PATH=

# Required when DB_BACKEND=supabase. Find these in Supabase Project Settings > API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret
SUPABASE_ANON_KEY=your-anon-key

# ---------------- AI (multi-provider) ----------------
# Configure any combination of the three providers below by setting their
# API keys. AI_PROVIDER picks which one is tried FIRST: "gemini",
# "openrouter", "groq", or "auto" (tries Gemini -> OpenRouter -> Groq, in
# that order — also what happens if AI_PROVIDER is left blank). Whatever
# is tried first, if it fails for ANY reason — HTTP 429/quota exceeded
# (e.g. Gemini's "429 RESOURCE_EXHAUSTED"), timeout, network error,
# invalid API key, any 5xx, or a malformed response — the app automatically
# falls through the remaining providers you've configured, in fixed
# priority order: Gemini -> OpenRouter -> Groq -> rule-based engine (the
# rule-based engine is always the final, guaranteed fallback and needs no
# configuration). A provider with no key set is skipped entirely, not
# attempted. Every attempt and failure is logged with the exact reason and
# response time (backend/logs/app.log) — never a silent fallback, and the
# app never crashes because of an AI provider issue.
AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter: https://openrouter.ai/keys — one API key gives access to many
# models; the free tier includes several. See openrouter.ai/models for options.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Groq: https://console.groq.com/keys — free tier, very fast inference.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# USE_GEMINI=false   # legacy override: keep GEMINI_API_KEY set but skip Gemini specifically

# ---------------- Email (SMTP) for forgot/reset password ----------------
# If any of these are blank, forgot-password falls back to returning the
# reset token directly in the API response (current dev-mode behavior).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5050

# ---------------- File storage ----------------
# "local" (default, backend/uploads/) or "supabase" (Supabase Storage)
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=documents

# ---------------- Logging ----------------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------------- Session security ----------------
# Secure requires HTTPS — enable only when actually deployed behind TLS.
# Browsers (and curl) silently refuse to send a Secure-flagged cookie back
# over plain HTTP, so leave this false for local http://localhost dev.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
# Idle/inactivity timeout in minutes — the session expiry slides forward on
# each request, so this logs a user out after N minutes of no activity,
# not N minutes after login regardless of activity.
SESSION_TIMEOUT_MINUTES=60

# ---------------- Rate limiting ----------------
# In-memory, per-process limiter (see backend/security.py). Applies to
# login/register/forgot-password/reset-password. Set false to disable
# (e.g. for load testing).
RATE_LIMIT_ENABLED=true